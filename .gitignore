# ==========================================================
# Root .gitignore for Classwork Project (Go + Angular)
# ==========================================================

# ----------------------------------------------------------
# Environment, Credentials & Secret Files
# ----------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.production
*.env.development
*.env.backup
*.secret
*.secrets
*.token
credentials.json
service-account*.json
client_secret*.json
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.kdbx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ----------------------------------------------------------
# Go Binaries and Build / Debug Artifacts
# ----------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
__debug_bin*
__debug_bin*.*
backend/__debug_bin*
backend/__debug_bin*.exe
backend/backend.exe
backend/backend
backend/main
backend/bin/
bin/

# Delve Debugger Artifacts
.dlv/
debug
debug.test

# ----------------------------------------------------------
# Database & Local Storage Files
# ----------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.dump

# ----------------------------------------------------------
# Node & Frontend (Angular) Package Managers
# ----------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
.angular/
**/.angular/
.npm/
package-lock.json.backup

# ----------------------------------------------------------
# Logs
# ----------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
libpeerconnection.log
testem.log

# ----------------------------------------------------------
# IDEs and Editors
# ----------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
.history/
*.swp
*.swo
*~
.project
.classpath
.c9/

# ----------------------------------------------------------
# Operating System Files
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----------------------------------------------------------
# Temporary & Cache Directories
# ----------------------------------------------------------
tmp/
**/tmp/
temp/
**/temp/
out-tsc/
bazel-out/
.sass-cache/
coverage/
connect.lock
