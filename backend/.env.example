# ==========================================================
# ClassWork Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# ==========================================================

# Server Configuration
ENV=development
HOST=0.0.0.0
PORT=8080
READ_TIMEOUT=60s
WRITE_TIMEOUT=60s
IDLE_TIMEOUT=120s

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=classwork_db
DB_SSLMODE=disable
DB_CONN_TIMEOUT=10s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Optional: Direct PostgreSQL Connection URL (takes precedence over individual DB_* variables if set)
# DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/classwork_db?sslmode=disable

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_EXPIRATION=72h
JWT_REFRESH_TIME=24h

# Google Gemini AI Integration (Optional)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
