# Server Configuration
ENV=development
HOST=0.0.0.0
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=classwork
DB_SSLMODE=disable
DB_CONN_TIMEOUT=10s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Optional: Direct PostgreSQL Connection URL (takes precedence over individual DB_* variables if set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/classwork?sslmode=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=72h
JWT_REFRESH_TIME=24h
